<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharpWarden\SharpWarden.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reuse the configuration model of the tests, so both always match. -->
    <Compile Include="..\SharpWarden.Tests\TestConfig.cs" Link="TestConfig.cs" />
  </ItemGroup>

</Project>
